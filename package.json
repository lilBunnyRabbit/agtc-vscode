{
  "name": "agtc",
  "displayName": "Agent Traffic Control",
  "description": "Every Claude Code and Codex session on your machine, in the sidebar.",
  "version": "0.1.0",
  "publisher": "lilbunnyrabbit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lilBunnyRabbit/agtc-vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agtc",
          "title": "Agent Traffic Control",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agtc": [
        {
          "type": "webview",
          "id": "agtc.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "agtc.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "agtc"
      },
      {
        "command": "agtc.toggleInactive",
        "title": "Show Inactive Sessions",
        "icon": "$(history)",
        "category": "agtc"
      },
      {
        "command": "agtc.markAllSeen",
        "title": "Mark All as Seen",
        "icon": "$(check-all)",
        "category": "agtc"
      },
      {
        "command": "agtc.markSeen",
        "title": "Mark as Seen",
        "category": "agtc"
      },
      {
        "command": "agtc.copyResume",
        "title": "Copy Resume Command",
        "category": "agtc"
      },
      {
        "command": "agtc.openFolder",
        "title": "Open Checkout in New Window",
        "category": "agtc"
      },
      {
        "command": "agtc.jump",
        "title": "Jump to Session",
        "category": "agtc"
      },
      {
        "command": "agtc.next",
        "title": "Next Running Session",
        "category": "agtc"
      },
      {
        "command": "agtc.previous",
        "title": "Previous Running Session",
        "category": "agtc"
      },
      {
        "command": "agtc.jumpWaiting",
        "title": "Jump to the Session That Needs You",
        "category": "agtc"
      },
      {
        "command": "agtc.new",
        "title": "New Agent in a Checkout",
        "icon": "$(add)",
        "category": "agtc"
      },
      {
        "command": "agtc.newWorktree",
        "title": "New Agent in a New Worktree",
        "category": "agtc"
      },
      {
        "command": "agtc.moveToWorktree",
        "title": "Move Session to a New Worktree",
        "category": "agtc"
      },
      {
        "command": "agtc.resume",
        "title": "Resume Session",
        "category": "agtc"
      },
      {
        "command": "agtc.compose",
        "title": "Start an Agent with a Task",
        "icon": "$(rocket)",
        "category": "agtc"
      },
      {
        "command": "agtc.home",
        "title": "Home",
        "icon": "$(home)",
        "category": "agtc"
      }
    ],
    "keybindings": [
      {
        "command": "agtc.next",
        "key": "cmd+alt+j"
      },
      {
        "command": "agtc.previous",
        "key": "cmd+alt+k"
      },
      {
        "command": "agtc.jumpWaiting",
        "key": "cmd+alt+n"
      },
      {
        "command": "agtc.home",
        "key": "cmd+alt+t"
      },
      {
        "command": "agtc.sessions.focus",
        "key": "cmd+alt+a"
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+1",
        "args": 1
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+2",
        "args": 2
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+3",
        "args": 3
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+4",
        "args": 4
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+5",
        "args": 5
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+6",
        "args": 6
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+7",
        "args": 7
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+8",
        "args": 8
      },
      {
        "command": "agtc.jumpDigit",
        "key": "cmd+alt+9",
        "args": 9
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agtc.home",
          "when": "view == agtc.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agtc.refresh",
          "when": "view == agtc.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agtc.toggleInactive",
          "when": "view == agtc.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agtc.markAllSeen",
          "when": "view == agtc.sessions",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agtc.markSeen",
          "when": "false"
        },
        {
          "command": "agtc.copyResume",
          "when": "false"
        },
        {
          "command": "agtc.openFolder",
          "when": "false"
        },
        {
          "command": "agtc.jump",
          "when": "false"
        },
        {
          "command": "agtc.moveToWorktree",
          "when": "false"
        },
        {
          "command": "agtc.resume",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Traffic Control",
      "properties": {
        "agtc.days": {
          "type": "number",
          "default": 7,
          "description": "How many days back inactive sessions are listed."
        },
        "agtc.resumeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Resume the agents that ran in this window when it reopens."
        },
        "agtc.terminalLocation": {
          "type": "string",
          "enum": [
            "panel",
            "editor"
          ],
          "default": "panel",
          "description": "Where new agent terminals open."
        },
        "agtc.baseBranch": {
          "type": "string",
          "default": "",
          "description": "New worktrees branch from here; empty uses the remote's default branch."
        },
        "agtc.worktreeDir": {
          "type": "string",
          "default": ".claude/worktrees",
          "description": "Where new worktrees go, relative to the repository unless absolute."
        },
        "agtc.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the home page when a window starts."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node22 --sourcemap",
    "watch": "bun run build -- --watch",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "package": "bunx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "bun run build",
    "dev": "bun run build && \"/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code\" --extensionDevelopmentPath=\"$PWD\" --new-window"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.106.1",
    "bun-types": "^1.4.2",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  }
}
