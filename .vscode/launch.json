{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Extension (needs the inspector reachable on localhost)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "watch"
    }
  ]
}
